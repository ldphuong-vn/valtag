{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "whoami",
    "namespace": "higress-system",
    "annotations": {
      "higress.io/destination": "whoami-demo.dns:80",
      "higress.io/ignore-path-case": "false"
    }
  },
  "spec": {
    "ingressClassName": "higress",
    "rules": [
      {
        "http": {
          "paths": [
            {
              "path": "/whoami",
              "pathType": "Prefix",
              "backend": {
                "resource": {
                  "apiGroup": "networking.higress.io/v1",
                  "kind": "McpBridge",
                  "name": "default"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
