# ─── PostgreSQL ───
POSTGRES_USER=valt
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=valt

# ─── Server ───
PORT=8080
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
SERVER_KEK=change_me_32_byte_hex_encoded_key
VAULT_MASTER_KEY=change_me_generate_with_openssl_rand_base64_32

# Audit IP attribution: trust X-Forwarded-For/X-Real-IP headers.
# true  = server behind a trusted reverse proxy (the compose default, Caddy)
# false = directly exposed; headers are client-controlled (report §4.7)
TRUST_PROXY_XFF=true

# Prometheus /metrics endpoint (Go runtime + HTTP counters). Opt-in;
# scrape on an internal network only — no auth on this endpoint.
METRICS_ENABLED=false

# Rate limiter behavior when Redis is unreachable (agents only):
# false = reject with 503 (fail-closed — the limit can't be bypassed)
# true  = pass through (availability over bypass-resistance)
RATE_LIMIT_FAIL_OPEN=false

# ─── SMTP (Email Notifications) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@valt.dev

# ─── Telegram (optional approvals channel) ───
# Required when TELEGRAM_BOT_TOKEN is set: sent to Telegram as secret_token
# via SetWebhook and verified on every webhook callback (fail-closed).
# Generate with: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=valtbot
TELEGRAM_WEBHOOK_SECRET=

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
DASHBOARD_URL=http://localhost:3000

# ─── Dashboard ───
NEXT_PUBLIC_API_URL=http://localhost:8443
BACKEND_URL=http://localhost:8080

# ─── Production Only ───
# DOMAIN=valt.dev
# ACME_EMAIL=admin@valt.dev
